# Copy to .dev.vars for `wrangler dev`. Never commit .dev.vars. Values below are local placeholders only.
ENVIRONMENT=local
DATABASE_URL=postgres://library:library@localhost:5432/library
# 32+ random characters, e.g. `openssl rand -hex 32`
SESSION_SECRET=
DEMO_ACCOUNTS_ENABLED=true
DEMO_LIBRARIAN_EMAIL=librarian@demo.test
DEMO_LIBRARIAN_PASSWORD=
DEMO_ADMIN_EMAIL=admin@demo.test
DEMO_ADMIN_PASSWORD=
BOOTSTRAP_ADMIN_EMAILS=
# Google sign-in: set both or neither. While they are unset, the "Sign in with Google" button hides.
# Redirect URI to register: <origin>/api/auth/google/callback
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
LOAN_DAYS=14
MAX_ACTIVE_LOANS=5
AI_FAKE=true
